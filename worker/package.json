{
  "name": "sla-monitor-worker",
  "version": "1.0.0",
  "private": true,
  "description": "Stateless serverless function: parses, validates and cleans SLA monitoring CSVs, persists to D1, and serves stats/logs.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init:local": "wrangler d1 execute sla-db --local --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute sla-db --remote --file=./schema.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250620.0",
    "typescript": "^5.5.4",
    "wrangler": "^3.114.0"
  }
}
